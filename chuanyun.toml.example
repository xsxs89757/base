# ===========================================
# 穿云项目级配置 —— 复制为 chuanyun.toml 后 ./dev.sh 自动应用
#
#   cp chuanyun.toml.example chuanyun.toml
#
# 这个文件**可以提交到 git 和团队共享**（里面没有密钥；auth 是访问口令，
# 按需自行决定要不要入库）。穿云客户端没装/没开时整份配置静默跳过。
# ===========================================

# 隧道名前缀，决定公网地址：{你的用户名}-{project}-{name}.{域名后缀}
# 加前缀是必须的：公网地址里不含项目信息，两个项目都叫 "api" 会直接撞名。
# 留空则回落到 .deploy.env 的 PROJECT_NAME，再没有就用仓库目录名。
project = "base"

# -------------------------------------------------------
# [[tunnels]] 我暴露出去的服务
#
# 只用于 **dev.sh 不启动** 的服务：手工起的进程、docker 容器、另一个终端里的服务。
# 这里的 port 按原样使用（不做端口避让）——语义是"把已经跑在这个端口上的东西暴露出去"，
# 换成别的端口就指向空气了。
#
# 后端和 admin 前端不用写：dev.sh 已自动建隧道，且端口被占时会自动改用空闲端口，
# 写死在这里反而会指错。dev.project.sh 里自己起的服务用 chuanyun_up 现取现用。
# -------------------------------------------------------

#[[tunnels]]
#name = "docs"        # → {用户}-base-docs.{域名}
#port = 9000

# -------------------------------------------------------
# [[connects]] 我接入的别人的服务
#
# 把同事已经开好的隧道接到本机端口上：前端同学不用自己跑后端，直接指向后端同学的机器。
# local_port 按原样占用（本地代码写死指向它，避让就没意义了），
# 所以它要避开本项目自己的端口；dev.sh 会先建立 connect 再解析自身端口，自动绕开。
# -------------------------------------------------------

#[[connects]]
#local_port = 8082           # 本机哪个端口
#from = "zhangsan-api"       # 同事的隧道子域名；也可以写完整 URL
#auth = "user:pass"          # 对方隧道设了访问口令才需要
